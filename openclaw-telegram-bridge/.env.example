# ============================================================
#  OpenClaw Telegram Bridge - 环境变量配置
# ============================================================

# [必填] Telegram Bot Token - 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=your_bot_token_here

# [必填] OpenClaw Gateway 地址
# 本机部署默认: http://127.0.0.1:18789
# 如果 OpenClaw 在另一台服务器: http://远程IP:18789
OPENCLAW_API_URL=http://127.0.0.1:18789

# [可选] OpenClaw API 密钥（如果配置了鉴权）
OPENCLAW_API_KEY=

# [可选] 使用的 AI 模型（传递给 OpenClaw）
# 如果留空，OpenClaw 会使用其默认模型
OPENCLAW_MODEL=

# [可选] 系统提示词 - 定义 AI 的角色和行为
SYSTEM_PROMPT=你是一个有用的 AI 助手，通过 Telegram 与用户交流。请用简洁友好的方式回答问题。

# [可选] 单条回复最大字符数（Telegram 限制 4096）
MAX_REPLY_LENGTH=4000

# [可选] OpenClaw API 超时时间（毫秒）
API_TIMEOUT=120000

# [可选] 日志级别: debug | info | warn | error
LOG_LEVEL=info

# [可选] 允许使用 Bot 的 Telegram 用户 ID（逗号分隔）
# 留空表示允许所有人使用
# 获取 ID: 给 @userinfobot 发消息
ALLOWED_USER_IDS=
